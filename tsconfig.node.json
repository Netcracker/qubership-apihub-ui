{
  "compilerOptions": {
    /* TS 6 reports moduleResolution:node as deprecated (TS5107); it still functions through 6.x. */
    "ignoreDeprecations": "6.0",
    "composite": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts"
  ]
}
