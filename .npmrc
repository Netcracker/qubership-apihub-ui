@netcracker:registry=https://npm.pkg.github.com/
registry=https://registry.npmjs.org/
# @grafana/faro-react@2.7.1 declares react-router@^7 as an OPTIONAL peer; this repo
# is on react-router 6.18.0 (supported via createReactRouterV6Options). npm still
# errors on the mismatched optional peer, so relax peer resolution for installs.
legacy-peer-deps=true